{
  "name": "velabody-compositor",
  "private": true,
  "description": "Compositor Remotion de VELABODY: arma el reel desde el armado.json de velabody.py, sin Premiere.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "brief": ".venv\\Scripts\\python -I ../_HERRAMIENTAS/preparar_brief.py",
    "baja": ".venv\\Scripts\\python -I herramientas/lote.py --calidad baja",
    "alta": ".venv\\Scripts\\python -I herramientas/lote.py --calidad alta",
    "entregar": ".venv\\Scripts\\python -I herramientas/lote.py --solo-entregar",
    "limpiar": ".venv\\Scripts\\python -I herramientas/limpiar_salidas.py",
    "pieza": ".venv\\Scripts\\python -I herramientas/piloto.py",
    "verificar": ".venv\\Scripts\\python -I herramientas/verificar_entrega.py",
    "pruebas": ".venv\\Scripts\\python -I -m unittest discover -s herramientas -p test_*.py && tsc --noEmit",
    "tipos": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
